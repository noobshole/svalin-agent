{
  "name": "@svalin-agent/api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dev:worker": "npx --yes wrangler@4.146.0 dev",
    "index:near": "tsx scripts/near-index.ts",
    "index:verify": "tsx scripts/verify-index.ts",
    "deploy:worker": "npx --yes wrangler@4.146.0 deploy"
  },
  "dependencies": {
    "@coinbase/x402": "^2.1.0",
    "@hono/node-server": "^2.1.4",
    "@solana/kit": "^5.5.1",
    "@svalin-agent/chain-config": "workspace:*",
    "@svalin-agent/shared": "workspace:*",
    "@x402/core": "^2.28.0",
    "@x402/extensions": "^2.28.0",
    "@x402/hono": "^2.28.0",
    "@x402/near": "~2.28.0",
    "@x402/svm": "^2.28.0",
    "hono": "^4.13.13",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vitest": "^5.0.4"
  }
}
