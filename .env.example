# ─────────────────────────── Svalin API (apps/api) ───────────────────────────
NODE_ENV=development
PORT=4000
# Public URL of the API, used in /llms.txt and /openapi.json
PUBLIC_BASE_URL=http://localhost:4000
# Browser origins allowed to call the API directly (the web app calls it server-side)
ALLOWED_ORIGINS=http://localhost:3000

# Live Solana data. Free key at https://dashboard.helius.dev. Without it the API
# serves clearly-labelled sample data and refuses to start in production.
HELIUS_API_KEY=
# PORTFOLIO_SOURCE=live|mock   (defaults to live when HELIUS_API_KEY is set)
# Live NEAR data needs no key. Defaults: FastNEAR API, FastNEAR RPC, Ref Finance prices.
# FASTNEAR_API_URL=https://api.fastnear.com
# NEAR_RPC_URL=https://rpc.mainnet.fastnear.com
# NEAR_PRICE_API_URL=https://indexer.ref.finance/list-token-price
PORTFOLIO_CACHE_SECONDS=60

# ── x402 payments ── set at least one payTo to turn the paywall on.
# Use dedicated receiving wallets. These are public addresses, never private keys.
PAY_TO_SOLANA=
# NEAR account ID, e.g. svalin-pay.near (a .testnet account on testnet)
PAY_TO_NEAR=
# testnet = Solana devnet + NEAR testnet (default outside production); mainnet in production
X402_ENV=testnet
# Solana facilitator. Defaults: mainnet → https://facilitator.payai.network,
# testnet → https://x402.org/facilitator
X402_FACILITATOR_URL=
# NEAR facilitator. Defaults: mainnet → https://x402.mikedotexe.com,
# testnet → https://test.x402.mikedotexe.com. Request an API key (one per network and payee) at
# https://github.com/fastnear/x402-facilitator/issues/new?template=access_request.yml
NEAR_FACILITATOR_URL=
NEAR_FACILITATOR_API_KEY=
# Recommended in production: Coinbase Developer Platform secret API key. When both are set,
# Solana payments settle through the CDP facilitator first (required for the x402 Bazaar
# listing) and the Solana facilitator above becomes the fallback.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# Price per call in USDC (these are the defaults)
PRICE_PORTFOLIO_USD=$0.002
PRICE_RISK_USD=$0.004
PRICE_BRIEF_USD=$0.02

# Free demo limits (protects your Helius budget)
DEMO_REQUESTS_PER_HOUR=10
DEMO_REQUESTS_PER_DAY_GLOBAL=2000
# Proxies your host puts in front of the API (Railway, Render, Fly.io: 1; local, no proxy: 0 or 1)
TRUSTED_PROXY_HOPS=1
# Optional shared secret (24+ characters) for a server of yours that calls the free scan for
# visitors and passes their IP. The bundled website calls the API from the browser and needs none.
WEB_FORWARDING_SECRET=

# Optional: LLM-written briefs on /v1/brief. Without a key a template narrator is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Optional: payments ledger (run supabase/migrations first)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────── Web (apps/web) ───────────────────────────
# The API the website calls from the browser (built into the pages: rebuild if it changes).
# The API must list the website's origin in ALLOWED_ORIGINS.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
